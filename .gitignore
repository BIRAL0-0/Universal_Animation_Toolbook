cache/
*.npz



# Toolbook install artifacts (npm/postinstall)
universal_toolbook/node_modules/
universal_toolbook/package-lock.json.partial

# Renders, QA frames and delivery bundles are build artifacts, not source
output/
work/



downloads/poster.jpg

# resumable render chunk caches + intermediate mixes (regenerable, hundreds of MB)
.work_*/
