# Byte-compiled / caches
__pycache__/
*.pyc
.venv/
venv/

# Node canvas backend (installed at run time)
node_modules/

*.partial

# Offline neural voices (~60 MB each) are fetched, never committed
assets/voices/
*.onnx
*.onnx.json

# Self-hosted TTS model weights (cache/tts: kokoro.onnx 92 MB + voices.npz 6 MB).
