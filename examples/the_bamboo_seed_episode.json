      "dialogue": [
        {
          "speaker": "narrator",
          "text": "Then, in the fifth year, the sun came up on a shape that had not been there the night before.",
          "pause_after": 0.5
        },
        {
          "speaker": "narrator",
          "text": "It came up three feet before breakfast.",
          "pause_after": 0.5
        },
        {
          "speaker": "narrator",
          "text": "It came up so fast that the neighbour heard it and came back out to the fence.",
          "pause_after": 0.5
        },
        {
          "speaker": "narrator",
          "text": "Nothing. He had done nothing different. That was the thing.",
          "pause_after": 0.7
        }
