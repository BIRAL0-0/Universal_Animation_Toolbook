      "dialogue": [
        {
          "speaker": "narrator",
          "text": "The bamboo did not grow in six weeks. It grew for five years and showed up in six weeks.",
          "pause_after": 0.6
        },
        {
          "speaker": "narrator",
          "text": "The farmer stood under it and looked up at all that green, and he did not feel lucky.",
          "pause_after": 0.5
        },
        {
          "speaker": "narrator",
          "text": "He felt like a man who had watered a seed every morning for five years.",
          "pause_after": 0.6
        },
        {
          "speaker": "narrator",
          "text": "Nothing was wasted. It was growing where no one could see.",
