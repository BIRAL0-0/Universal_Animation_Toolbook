      "dialogue": [
        {
          "speaker": "narrator",
          "text": "Roots. Wider every season. Deeper every rain.",
          "pause_after": 0.5
        },
        {
          "speaker": "narrator",
          "text": "Nothing above the ground would have told you.",
          "pause_after": 0.5
        },
        {
          "speaker": "narrator",
          "text": "The ground line stayed flat, and the measurement stayed at zero, and the whole time the work was real.",
          "pause_after": 0.5
        },
        {
          "speaker": "narrator",
          "text": "It was happening in the one place nobody was looking.",
          "pause_after": 0.7
        }
