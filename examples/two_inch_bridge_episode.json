        { "speaker": "narrator", "text": "Then the city called about the Ogun river.", "pause_after": 0.4 },
        { "speaker": "narrator", "text": "Master Okoro gave her one rule.", "pause_after": 0.3 },
        { "speaker": "master", "text": "Twelve weeks. Not nine.", "pause_after": 0.35, "allow_long_pause": false },
        { "speaker": "narrator", "text": "Nia wrote it down. Then she wrote it smaller.", "pause_after": 0.5 }
